{
  "name": "@duya/computer-use-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local copy of computer-use-demo v0.4 types — wakes/grounding source for OSContextBridge. Full daemon runs out-of-tree at E:\\Projects\\computer-use-demo (sibling repo).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "npm run clean && tsc --incremental",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config tests/vitest.config.ts run",
    "test:watch": "vitest --config tests/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}