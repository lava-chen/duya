{
  "name": "@duya/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The run execution engine: implements AgentRuntimeApi, owns run identity, sequence numbers, and the RunEvent stream, and projects those events back onto the legacy SSE contract the product UI already consumes.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duya/agent-core": "0.1.0",
    "@duya/agent-protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
