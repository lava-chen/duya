{
  "schemaVersion": "duya.plugin.v2",
  "id": "com.duya.figma-design",
  "name": "Figma Design",
  "version": "0.1.0",
  "publisher": { "name": "Duya", "verified": true },
  "categories": ["development"],
  "components": {
    "mcpServers": ["figma"],
    "appConnections": [],
    "skills": [
      "design-context-extraction",
      "design-system-mapping",
      "component-implementation",
      "visual-comparison",
      "write-back-to-figma"
    ],
    "workflows": [
      "implement-from-figma",
      "extract-design-tokens",
      "compare-implementation-vs-design",
      "write-back-to-figma"
    ]
  },
  "permissionPolicy": {
    "defaultMode": "read",
    "writeActionsRequireApproval": true,
    "destructiveActionsRequireApproval": true
  },
  "setup": [
    {
      "id": "figmaApiKey",
      "label": "Figma personal access token (preferred: scoped to Dev Mode)",
      "type": "secret",
      "required": true
    }
  ],
  "platforms": ["windows", "macos", "linux"],
  "scope": ["user", "project", "workspace"]
}
