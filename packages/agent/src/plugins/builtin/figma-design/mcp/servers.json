{
  "servers": [
    {
      "name": "figma",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${setup.figmaApiKey}"
      },
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.figma.com/mcp", "authentication": "oauth" }
    }
  ]
}
