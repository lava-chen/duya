{
  "defaultMode": "read",
  "writeActionsRequireApproval": true,
  "destructiveActionsRequireApproval": true,
  "tiers": {
    "read": [
      "supabase.list_tables",
      "supabase.describe_table",
      "supabase.list_indexes",
      "supabase.list_policies",
      "supabase.list_migrations",
      "supabase.get_migration",
      "supabase.list_edge_functions",
      "supabase.get_edge_function",
      "supabase.list_edge_function_logs",
      "supabase.list_auth_providers",
      "supabase.get_auth_config",
      "supabase.query.select"
    ],
    "draft": [
      "supabase.draft_migration"
    ],
    "write": [
      "supabase.create_table",
      "supabase.alter_table",
      "supabase.create_index",
      "supabase.create_policy",
      "supabase.update_policy",
      "supabase.upsert_row",
      "supabase.update_row",
      "supabase.create_edge_function_version",
      "supabase.update_auth_config"
    ],
    "modify": [
      "supabase.apply_migration",
      "supabase.deploy_edge_function",
      "supabase.create_storage_bucket",
      "supabase.alter_auth_provider"
    ],
    "destructive": [
      "supabase.drop_table",
      "supabase.drop_column",
      "supabase.truncate_table",
      "supabase.delete_row",
      "supabase.delete_edge_function",
      "supabase.delete_storage_bucket",
      "supabase.rotate_service_key",
      "supabase.delete_migration"
    ]
  },
  "notes": [
    "Reading tables, policies, migrations, and logs runs automatically.",
    "Creating tables, indexes, policies, and Edge Function versions are",
    "write-tier — confirm before the first write and always show the",
    "proposed SQL or function code. Applying a migration and deploying",
    "an Edge Function are modify-tier because they change the live",
    "project. Drop, truncate, delete, and key rotation are",
    "destructive-tier. Unlisted actions are bumped one tier above the",
    "conservative default per the design doc §6."
  ]
}
