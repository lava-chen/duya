{
  "servers": [
    {
      "name": "supabase",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase",
        "--access-token",
        "${setup.supabaseAccessToken}",
        "--project-ref",
        "${setup.supabaseProjectRef}"
      ],
      "env": {},
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.supabase.com/mcp", "authentication": "oauth" }
    }
  ]
}
