{
  "servers": [
    {
      "name": "vercel",
      "command": "npx",
      "args": ["-y", "vercel-mcp-adapter"],
      "env": {
        "VERCEL_TOKEN": "${setup.vercelToken}",
        "VERCEL_TEAM_ID": "${setup.vercelTeamId}"
      },
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.vercel.com", "authentication": "oauth" }
    }
  ]
}
