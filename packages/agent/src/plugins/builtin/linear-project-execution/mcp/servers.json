{
  "servers": [
    {
      "name": "linear",
      "command": "npx",
      "args": ["-y", "@tacticlaunch/mcp-linear"],
      "env": {
        "LINEAR_API_KEY": "${setup.linearApiKey}"
      },
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.linear.app/mcp", "authentication": "oauth" }
    }
  ]
}
