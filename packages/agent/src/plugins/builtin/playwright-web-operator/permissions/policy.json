{
  "defaultMode": "read",
  "writeActionsRequireApproval": true,
  "destructiveActionsRequireApproval": true,
  "tiers": {
    "read": [
      "browser.navigate",
      "browser.navigate_back",
      "browser.take_screenshot",
      "browser.snapshot",
      "browser.find",
      "browser.tabs.list",
      "browser.tabs.switch",
      "browser.console_messages",
      "browser.network_requests",
      "browser.evaluate.readonly"
    ],
    "draft": [],
    "write": [
      "browser.click",
      "browser.hover",
      "browser.select_option",
      "browser.press_key",
      "browser.type",
      "browser.fill_form",
      "browser.scroll"
    ],
    "modify": [
      "browser.file_upload",
      "browser.form_submit",
      "browser.drop",
      "browser.evaluate.mutating"
    ],
    "destructive": [
      "browser.dialog.dismiss_destructive",
      "browser.navigate.to_untrusted"
    ]
  },
  "notes": [
    "Navigation and read-only extraction run automatically. Clicks and",
    "typing on a public page are write-tier and confirm first. Form",
    "submission and file upload are modify-tier because they mutate",
    "external state. Dialog dismissals that confirm destructive actions",
    "(e.g. 'Yes, delete') are destructive-tier."
  ]
}
