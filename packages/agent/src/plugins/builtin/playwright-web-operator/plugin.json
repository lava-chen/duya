{
  "schemaVersion": "duya.plugin.v2",
  "id": "com.duya.playwright-web-operator",
  "name": "Playwright Web Operator",
  "version": "0.1.0",
  "publisher": { "name": "Duya", "verified": true },
  "categories": ["automation"],
  "components": {
    "mcpServers": ["playwright"],
    "appConnections": [],
    "skills": [
      "browser-navigation",
      "structured-extraction",
      "form-operation",
      "frontend-verification",
      "end-to-end-testing"
    ],
    "workflows": [
      "operate-webpage",
      "extract-structured-info",
      "verify-local-frontend",
      "run-e2e-test"
    ]
  },
  "permissionPolicy": {
    "defaultMode": "read",
    "writeActionsRequireApproval": true,
    "destructiveActionsRequireApproval": true
  },
  "platforms": ["windows", "macos", "linux"],
  "scope": ["user", "project", "workspace"]
}
