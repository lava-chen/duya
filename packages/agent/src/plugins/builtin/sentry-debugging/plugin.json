{
  "schemaVersion": "duya.plugin.v2",
  "id": "com.duya.sentry-debugging",
  "name": "Sentry Debugging",
  "version": "0.1.0",
  "publisher": { "name": "Duya", "verified": true },
  "categories": ["development"],
  "components": {
    "mcpServers": ["sentry"],
    "appConnections": [],
    "skills": [
      "issue-investigation",
      "stacktrace-analysis",
      "regression-detection",
      "fix-and-verify"
    ],
    "workflows": [
      "investigate-latest-error",
      "trace-error-to-code",
      "fix-test-and-pr"
    ]
  },
  "permissionPolicy": {
    "defaultMode": "read",
    "writeActionsRequireApproval": true,
    "destructiveActionsRequireApproval": true
  },
  "setup": [
    {
      "id": "sentryAuthToken",
      "label": "Sentry auth token (org-level, read scope minimum; write scope for releases)",
      "type": "secret",
      "required": true
    },
    {
      "id": "sentryOrgSlug",
      "label": "Sentry organization slug",
      "type": "text",
      "required": true
    }
  ],
  "platforms": ["windows", "macos", "linux"],
  "scope": ["user", "project", "workspace"]
}
