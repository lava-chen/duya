{
  "servers": [
    {
      "name": "sentry",
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server"
      ],
      "env": {
        "SENTRY_AUTH_TOKEN": "${setup.sentryAuthToken}",
        "SENTRY_ORG_SLUG": "${setup.sentryOrgSlug}"
      },
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.sentry.dev", "authentication": "oauth" }
    }
  ]
}
