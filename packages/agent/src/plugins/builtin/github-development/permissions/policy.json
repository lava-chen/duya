{
  "defaultMode": "read",
  "writeActionsRequireApproval": true,
  "destructiveActionsRequireApproval": true,
  "tiers": {
    "read": [
      "repos.list",
      "repos.get",
      "repos.list_branches",
      "repos.list_commits",
      "repos.get_file_contents",
      "issues.list",
      "issues.get",
      "pull_requests.list",
      "pull_requests.get",
      "pull_requests.get_diff",
      "pull_requests.list_reviews",
      "pull_requests.list_comments",
      "actions.list_workflows",
      "actions.list_jobs",
      "actions.get_job_logs",
      "actions.list_runs",
      "releases.list",
      "releases.get",
      "tags.list"
    ],
    "draft": [
      "pull_requests.create_review_comment_draft"
    ],
    "write": [
      "issues.create",
      "issues.update",
      "issues.add_comment",
      "pull_requests.create_review",
      "pull_requests.add_comment",
      "pull_requests.update_branch",
      "pull_requests.create"
    ],
    "modify": [
      "repos.create_branch",
      "repos.create_or_update_file",
      "pull_requests.merge_draft"
    ],
    "destructive": [
      "pull_requests.merge",
      "releases.create",
      "releases.update",
      "releases.delete",
      "tags.delete",
      "issues.lock",
      "repos.delete"
    ]
  },
  "notes": [
    "Read-only actions (list repos, read files, view PRs, fetch Actions",
    "logs) run automatically. Creating issues and comments confirms first.",
    "Merging PRs and publishing releases require strong explicit",
    "confirmation (destructive tier). Unlisted actions are bumped one tier",
    "above the conservative default per the design doc §6."
  ]
}
