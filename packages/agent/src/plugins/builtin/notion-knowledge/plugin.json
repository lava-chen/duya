{
  "schemaVersion": "duya.plugin.v2",
  "id": "com.duya.notion-knowledge",
  "name": "Notion Knowledge",
  "version": "0.1.0",
  "publisher": { "name": "Duya", "verified": true },
  "categories": ["productivity"],
  "components": {
    "mcpServers": ["notion"],
    "appConnections": [],
    "skills": [
      "workspace-search",
      "research-documentation",
      "meeting-knowledge-capture",
      "database-maintenance",
      "spec-to-task"
    ],
    "workflows": [
      "search-and-synthesize",
      "organize-conversation-to-doc",
      "create-meeting-notes",
      "spec-to-tasks"
    ]
  },
  "permissionPolicy": {
    "defaultMode": "read",
    "writeActionsRequireApproval": true,
    "destructiveActionsRequireApproval": true
  },
  "setup": [
    {
      "id": "notionApiKey",
      "label": "Notion internal integration token (scoped to specific pages)",
      "type": "secret",
      "required": true
    }
  ],
  "platforms": ["windows", "macos", "linux"],
  "scope": ["user", "project", "workspace"]
}
