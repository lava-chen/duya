{
  "servers": [
    {
      "name": "notion",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\":\"Bearer ${setup.notionApiKey}\",\"Notion-Version\":\"2022-06-28\"}"
      },
      "envPassthrough": "allowlist",
      "_status": "fallback",
      "_officialRemote": { "transport": "streamable-http", "url": "https://mcp.notion.com/mcp", "authentication": "oauth" }
    }
  ]
}
