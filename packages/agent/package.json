{
  "name": "@duya/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file-parser": {
      "types": "./dist/file-parser/index.d.ts",
      "default": "./dist/file-parser/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "npm run clean && tsc --incremental",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts --watch",
    "test:coverage": "vitest --config tests/vitest.config.ts --coverage",
    "test:run": "vitest --config tests/vitest.config.ts run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@duya/cli": "0.1.0",
    "@duya/conductor": "0.1.0",
    "@duya/plugin-core": "0.1.0",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "better-sqlite3": "^11.10.0",
    "blessed": "^0.1.81",
    "chalk": "^5.6.2",
    "diff": "^8.0.4",
    "execa": "^9.6.1",
    "fast-xml-parser": "^4.5.0",
    "jimp": "^1.6.1",
    "jszip": "^3.10.1",
    "openai": "^6.33.0",
    "pdf-parse": "^1.1.1",
    "picomatch": "^4.0.4",
    "playwright": "^1.59.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/blessed": "^0.1.25",
    "@types/chrome": "^0.1.40",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "docx": "^9.7.1",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
