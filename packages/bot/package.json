{
  "name": "@duya/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure Bot domain: identity entry shapes, id rules, the identity journal state machine, and the identity application service. Zero IO, zero host dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"for(const t of ['dist','tsconfig.tsbuildinfo'])require('fs').rmSync(t,{recursive:true,force:true})\"",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duya/agent-protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
