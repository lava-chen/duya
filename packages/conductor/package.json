{
  "name": "@duya/conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DUYA canvas workspace UI — renders the surface the CanvasConductor agent drives",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ipc": {
      "types": "./dist/ipc.d.ts",
      "default": "./dist/ipc.js"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "default": "./src/renderer/index.ts"
    },
    "./renderer/*": {
      "types": [
        "./src/renderer/*.ts",
        "./src/renderer/*.tsx",
        "./src/renderer/*/index.ts",
        "./src/renderer/*/index.tsx"
      ],
      "default": [
        "./src/renderer/*.ts",
        "./src/renderer/*.tsx",
        "./src/renderer/*/index.ts",
        "./src/renderer/*/index.tsx"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "rbush": "^4.0.1",
    "zod": "^4.4.3"
  }
}
