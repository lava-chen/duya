{
  "name": "@duya/client-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side run projection and pure event-stream decoding.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"for(const t of ['dist','tsconfig.tsbuildinfo'])require('fs').rmSync(t,{recursive:true,force:true})\"",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duya/agent-protocol": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
