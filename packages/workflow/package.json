{
  "name": "@duya/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure workflow definition, journal, and scheduling contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node -e \"for(const t of ['dist','tsconfig.tsbuildinfo'])require('fs').rmSync(t,{recursive:true,force:true})\"",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duya/agent-core": "0.1.0",
    "@duya/agent-protocol": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  }
}
