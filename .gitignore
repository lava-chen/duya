_dbg-out.txt
.codex-artifacts/

# Local codegraph index
.codegraph/

# Local zcode / introspection index
.zcode/

# Ad-hoc scratch scripts left in repo root
/test-*.mjs
/*.cjs
/tc.out
/tc.out2
/diag.js
/fix-*.js

# Showcase / launch screenshot artifacts (regenerated by `npm run showcase`)
assets/showcase/

# Playwright scratch screenshots and ad-hoc agent/build output
output/

# Brainstorm visual companion scratch
.superpowers/

# Transient agent-session backups and scratch staging (never commit)
.duya-backup-*
.duya-stage/
.serena/

# Local ABI prebuilt artifacts + stash patch archives (machine-specific)
prebuilds/
.stash-archive/

# Voice / desktop probe artifacts (debug scratch, never commit)
voice-mic-*.ps1
voice-mic-probe.wav
voice-mic-probes/
probe-desktop-capture*.png
.tmp-activate-wechat.ps1

