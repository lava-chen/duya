# Dependencies
node_modules/

# Build outputs
.next/
dist/
dist-electron/
release*/
build/
*.tsbuildinfo

# Downloaded ripgrep binary (scripts/fetch-ripgrep.mjs) — fetched at build
# time, never committed.
resources/ripgrep/

# Generated assembled prompt docs (read-only local reference, not source)
/doya-general-prompt-assembled.md

# In-place TypeScript emit (when tsc is invoked with emit on, .d.ts and
# .js appear next to their .ts / .tsx sources). Track emit outputs by
# filename pattern rather than path so genuine hand-written .d.ts
# files (e.g. src/global.d.ts, src/vite-env.d.ts) stay tracked.
src/**/*.d.ts
src/**/*.d.ts.map
src/**/*.js
src/**/*.js.map
!src/**/*.stories.tsx
!src/**/*.stories.ts

# Storybook
.storybook/
storybook-static/
src/stories/
# Co-located story files (Storybook v8+ convention) — not committed
*.stories.tsx
*.stories.ts
**/__stories__/

# Environment files
.env
.env.local
.env.*.local

# Runtime data
.duya/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Coverage
coverage/

# Unit tests are tracked like any other source (colocated *.test.ts /
# *.spec.ts, e2e/*.spec.ts). No ignore rules for them: the previous
# blanket *.test.ts rule silently dropped every new test file unless it
# was individually negated below.

# Project specific
ui-screenshot-*.png
console_log.txt
test_permissions.txt
test_paper.pdf
duyaUI.pen

# Agent tools
.claude/
.trae/
.qoder/
.mimosa/
.playwright-mcp/
.playwright-cli/
.e2e-userdata/
tmp/

# Scratch debug / probe scripts (do not commit)
scripts/_probe-*.mjs
scripts/_probe-*.js
scripts/_scratch-*.mjs
scripts/_scratch-*.js
scripts/probe-*.cjs
test-results/

# Docs (keep only product-specs and release-notes)
docs/*/
!docs/product-specs/
!docs/release-notes/
docs/*.md

# Tests
# Tests: only the root-level `tests/` scratch directory is ignored.
# `packages/agent/tests/` and `packages/plugin-core/tests/` are intentionally
# tracked — they hold the project's unit-test source.
/tests/

# Bundled output
packages/agent/bundle/
packages/gateway/bundle/
packages/cli/bundle/

# Bundled output


.cache/

