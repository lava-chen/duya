+  it('does not silently shed native run events when the frame cap is reached', () => {
+    const { setStalled } = stallStdout();
+    const expectedSeqs = Array.from({ length: 2101 }, (_, index) => index + 1);
+
+    try {
+      for (const seq of expectedSeqs) sendEvent(nativeRunEvent(seq));
+    } finally {
+      const observed = readNativeFrames(drainCapturedFrames(setStalled));
+      expect(observed.every((event) =>
+        event.epoch === 7 && event.envelope.runId === 'run-pressure-test'
+      )).toBe(true);
+      const observedSeqs = observed.map((event) => event.envelope.seq);
+      const missingSeqs = expectedSeqs.filter((seq) => !observedSeqs.includes(seq));
+      expect(missingSeqs, 'missing native run:event sequence numbers').toEqual([]);
+    }
+  });
