-const originalWrite = process.stdout.write.bind(process.stdout);
-
 /** Force backpressure so frames pile up in the queue instead of draining. */
 function stallStdout(): { setStalled: (stalled: boolean) => void } {
   let stalled = true;
   const spy = vi.spyOn(process.stdout, 'write').mockImplementation(((
-    chunk: unknown,
-    ...rest: unknown[]
+    _chunk: unknown,
   ) => {
     if (stalled) return false;
-    return (originalWrite as (...a: unknown[]) => boolean)(chunk, ...rest);
+    return true;
   }) as never);
 
   return { setStalled: (value: boolean) => { stalled = value; } };
 }
 
+function drainCapturedFrames(setStalled: (stalled: boolean) => void): string[] {
+  const spy = vi.mocked(process.stdout.write);
+  const attemptedBeforeDrain = spy.mock.calls.map((call) => String(call[0]));
+  const drained: string[] = [];
+  setStalled(false);
+  spy.mockImplementation(((chunk: unknown) => {
+    drained.push(String(chunk));
+    return true;
+  }) as never);
+
+  try {
+    process.stdout.emit('drain');
+    return [...attemptedBeforeDrain, ...drained];
+  } finally {
+    // Restore stdout before assertions/reporting so the test cannot swallow
+    // Vitest's own output. The worker queue has also drained synchronously.
+    spy.mockRestore();
+  }
+}
+
+function nativeRunEvent(seq: number, text = 'native event'): Record<string, unknown> {
+  return {
+    type: 'run:event',
+    epoch: 7,
+    envelope: {
+      runId: 'run-pressure-test',
+      sessionId: 'session-pressure-test',
+      seq,
+      payload: { type: 'assistant.text_block', text },
+    },
+  };
+}
+
+function readNativeFrames(frames: readonly string[]): Array<{
+  epoch: unknown;
+  envelope: { runId?: unknown; seq?: unknown };
+}> {
+  return frames
+    .map((frame) => JSON.parse(frame) as Record<string, unknown>)
+    .filter((frame) => frame.type === 'run:event')
+    .map((frame) => ({
+      epoch: frame.epoch,
+      envelope: frame.envelope as { runId?: unknown; seq?: unknown },
+    }));
+}
+
 afterEach(() => {
