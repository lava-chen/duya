{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../packages/ui/src/*"
      ],
      "@duya/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@duya/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@duya/ui/styles.css": [
        "../../packages/ui/src/styles/globals.css"
      ]
    }
  },
  "include": [
    "src/main.tsx",
    "src/client/**/*.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../apps/desktop/src/renderer/global.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests"
  ]
}
