{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../../dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./src/main/types", "../../node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/main/*"],
      "@duya/agent/message": ["../../packages/agent/dist/message/index"],
      "@duya/agent/tool/allowedRoots": ["../../packages/agent/src/tool/allowedRoots.ts"],
      "@duya/agent-protocol/transcript": [
        "../../packages/agent-protocol/dist/transcript/index.d.ts"
      ],
      "@duya/plugin-core": ["../../packages/plugin-core/dist/index.d.ts"],
      "@duya/plugin-core/*": ["../../packages/plugin-core/dist/*"],
      "@duya/connectors": ["../../packages/connectors/dist/index.d.ts"],
      "@duya/connectors/*": ["../../packages/connectors/dist/*"]
    }
  },
  "include": ["src/contracts/**/*.ts", "src/main/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**", "**/__mocks__/**"]
}
