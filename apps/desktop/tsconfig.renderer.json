{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../packages/ui/src/*"
      ],
      "@duya/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@duya/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@duya/ui/styles.css": [
        "../../packages/ui/src/styles/globals.css"
      ],
      "@duya/plugin-core": [
        "../../packages/plugin-core/dist/index.d.ts"
      ],
      "@duya/plugin-core/*": [
        "../../packages/plugin-core/dist/*"
      ],
      "@duya/connectors": [
        "../../packages/connectors/dist/index.d.ts"
      ],
      "@duya/connectors/*": [
        "../../packages/connectors/dist/*"
      ],
      "@duya/input-completion": [
        "../../packages/input-completion/dist/index.d.ts"
      ],
      "@duya/input-completion/*": [
        "../../packages/input-completion/dist/*"
      ],
      "@duya/command-catalog": [
        "../../packages/command-catalog/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "../../dist",
    "src/renderer/**/*.stories.tsx",
    "src/renderer/**/*.stories.ts",
    "src/renderer/**/__stories__/**",
    "../../packages/ui/src/**/*.stories.tsx",
    "../../packages/ui/src/**/*.stories.ts",
    "../../packages/ui/src/**/__stories__/**"
  ]
}
