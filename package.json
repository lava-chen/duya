{
  "name": "duya",
  "version": "0.8.1",
  "description": "AI Agent Desktop Client (Beta)",
  "author": "lava-chen",
  "private": true,
  "main": "dist-electron/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:ai": "npm run -w @duya/ai build",
    "build:agent": "npm run build:ai && npm run build:cli && (npm run build:conductor || echo conductor-pass1-errors-ignored) && npm run -w @duya/agent build && npm run -w @duya/conductor clean && npm run build:conductor",
    "build:cli": "npm run -w @duya/cli build",
    "build:conductor": "npm run -w @duya/conductor build",
    "build:gateway": "npm run -w @duya/gateway build",
    "build:voice": "npm run -w @duya/voice build",
    "bundle:agent": "npm run build:ai && node scripts/build-agent-bundle.mjs",
    "bundle:gateway": "node scripts/build-gateway-bundle.mjs",
    "build:cli-bundle": "node scripts/build-cli-bundle.mjs",
    "rebuild:agent": "npm run build:agent && npm run bundle:agent",
    "preview": "vite preview",
    "preelectron:dev": "node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:dev:nohmr": "node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:build": "node scripts/fetch-ripgrep.mjs && node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:preview": "node scripts/ensure-sqlite-abi.mjs electron",
    "fetch:ripgrep": "node scripts/fetch-ripgrep.mjs",
    "electron:dev": "npm run build:gateway && npm run bundle:agent && npm run build:voice && npm run build:cli-bundle && node scripts/build-electron.mjs && concurrently -k \"vite --port 3000 --strictPort\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:dev:nohmr": "npm run build:gateway && npm run bundle:agent && npm run build:voice && npm run build:cli-bundle && node scripts/build-electron.mjs && cross-env DUYA_NO_HMR=1 concurrently -k \"vite --port 3000 --strictPort\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "npm run build:agent && npm run bundle:agent && npm run build:cli-bundle && npm run build:gateway && npm run bundle:gateway && npm run build:voice && npm run -w @duya/computer-use build && vite build && node scripts/build-electron.mjs",
    "electron:pack": "npm run electron:build && electron-builder --config electron-builder.yml",
    "electron:verify:packaged": "node scripts/verify-packaged-parity.mjs",
    "diagnose:env": "node scripts/diagnose-env.mjs",
    "diagnose:env-packed": "node scripts/diagnose-env.mjs --packaged",
    "diagnose:env-json": "node scripts/diagnose-env.mjs --json",
    "electron:preview": "npm run build:gateway && npm run build:agent && npm run bundle:agent && vite build && node scripts/build-electron.mjs && cross-env DUYA_PREVIEW_MODE=true electron .",
    "electron:pack:mac": "npm run electron:build && electron-builder --mac --config electron-builder.yml",
    "electron:pack:win": "npm run electron:build && electron-builder --win --config electron-builder.yml",
    "electron:pack:linux": "npm run electron:build && electron-builder --linux --config electron-builder.yml",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "npm run build:agent && tsc --noEmit",
    "typecheck:agent": "npm run build:cli && npm run -w @duya/agent typecheck",
    "typecheck:cli": "npm run -w @duya/cli typecheck",
    "typecheck:conductor": "npm run -w @duya/conductor typecheck",
    "typecheck:voice": "npm run -w @duya/voice typecheck",
    "typecheck:all": "npm run typecheck:web && npm run typecheck:agent && npm run typecheck:cli && npm run typecheck:conductor && npm run typecheck:voice",
    "pretest": "node scripts/ensure-sqlite-abi.mjs node",
    "pretest:watch": "node scripts/ensure-sqlite-abi.mjs node",
    "pretest:coverage": "node scripts/ensure-sqlite-abi.mjs node",
    "pretest:e2e": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:smoke": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:ipc": "node scripts/ensure-sqlite-abi.mjs electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:smoke": "npx playwright test --config=e2e/playwright.config.ts --project=smoke",
    "test:e2e:ipc": "npx playwright test --config=e2e/playwright.config.ts --project=ipc",
    "build:electron": "node scripts/build-electron.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "showcase": "node scripts/showcase/showcase.mjs",
    "showcase:gif": "node scripts/showcase/showcase.mjs --gif",
    "showcase:compose-gif": "node scripts/showcase/compose-gif.mjs",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild",
    "rebuild:node": "node scripts/ensure-sqlite-abi.mjs node"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "gifenc": "^1.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.2",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@lobehub/icons": "^5.4.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tabler/icons-react": "^3.43.0",
    "@tanstack/react-query": "^5.101.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.3.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "croner": "^9.1.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "https-proxy-agent": "^9.0.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.22",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.0",
    "qrcode": "^1.5.4",
    "rbush": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "readable-stream": "^4.7.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "simple-icons": "^16.28.0",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^3.5.0",
    "write-file-atomic": "^7.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "node-abi": "^4.35.0"
  }
}
