{
  "name": "duya",
  "version": "0.8.1",
  "description": "Open-source, local-first AI agent foundation for Desktop, TUI, and Web",
  "author": "lava-chen",
  "private": true,
  "main": "dist-electron/main.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck:web-app": "npm run -w @duya/web typecheck",
    "web-app": "npm run -w @duya/web start",
    "dev": "vite",
    "dev:web": "npm run -w @duya/web dev",
    "build": "vite build",
    "build:web": "node scripts/build-packages.mjs --target @duya/web",
    "build:ai": "npm run -w @duya/ai build",
    "build:protocol": "npm run -w @duya/agent-protocol build",
    "build:core": "npm run -w @duya/agent-core build",
    "build:runtime": "npm run -w @duya/agent-runtime build",
    "build:plugin-core": "npm run -w @duya/plugin-core build",
    "build:packages": "node scripts/build-packages.mjs",
    "build:desktop:deps": "node scripts/build-packages.mjs --target @duya/desktop",
    "build:cli": "node scripts/build-packages.mjs --target @duya/cli && npm run -w @duya/cli build",
    "build:gateway": "npm run -w @duya/gateway build",
    "build:voice": "npm run -w @duya/voice build",
    "bundle:worker": "node scripts/build-host-worker-bundle.mjs",
    "plan:sync": "node scripts/architecture/plan-sync-check.mjs --strict",
    "bundle:verify": "node scripts/architecture/bundle-verify.mjs",
    "bundle:gateway": "node scripts/build-gateway-bundle.mjs",
    "build:cli-bundle": "node scripts/build-cli-bundle.mjs",
    "preview": "vite preview",
    "preelectron:dev": "node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:dev:nohmr": "node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:build": "node scripts/fetch-ripgrep.mjs && node scripts/ensure-sqlite-abi.mjs electron",
    "preelectron:preview": "node scripts/ensure-sqlite-abi.mjs electron",
    "fetch:ripgrep": "node scripts/fetch-ripgrep.mjs",
    "electron:dev": "npm run bundle:worker && npm run build:cli-bundle && node scripts/build-electron.mjs && node scripts/build-recorder-worker.mjs && concurrently -k \"vite --port 3000 --strictPort\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:dev:nohmr": "npm run bundle:worker && npm run build:cli-bundle && node scripts/build-electron.mjs && cross-env DUYA_NO_HMR=1 concurrently -k \"vite --port 3000 --strictPort\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "npm run build:desktop:deps && npm run bundle:worker && npm run build:cli-bundle && npm run bundle:gateway && vite build && node scripts/build-electron.mjs && node scripts/build-recorder-worker.mjs",
    "electron:pack": "npm run electron:build && electron-builder --config electron-builder.yml",
    "electron:verify:packaged": "node scripts/verify-packaged-parity.mjs",
    "check:packaged-artifacts": "node scripts/check-packaged-artifacts.mjs",
    "check:packaged-artifacts:bundle": "node scripts/check-packaged-artifacts.mjs --bundle",
    "check:packaged-artifacts:packaged": "node scripts/check-packaged-artifacts.mjs --packaged",
    "diagnose:env": "node scripts/diagnose-env.mjs",
    "diagnose:env-packed": "node scripts/diagnose-env.mjs --packaged",
    "diagnose:env-json": "node scripts/diagnose-env.mjs --json",
    "electron:preview": "npm run bundle:worker && vite build && node scripts/build-electron.mjs && cross-env DUYA_PREVIEW_MODE=true electron .",
    "electron:pack:mac": "npm run electron:build && electron-builder --mac --config electron-builder.yml",
    "electron:pack:win": "npm run electron:build && electron-builder --win --config electron-builder.yml",
    "electron:pack:linux": "npm run electron:build && electron-builder --linux --config electron-builder.yml",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "npm run build:packages && tsc --noEmit",
    "typecheck:electron": "npm run build:packages && node scripts/typecheck-electron-gate.mjs",
    "typecheck:electron:baseline": "node scripts/typecheck-electron-gate.mjs --write",
    "typecheck:protocol": "npm run -w @duya/agent-protocol typecheck",
    "typecheck:core": "npm run -w @duya/agent-core typecheck",
    "typecheck:client-core": "npm run -w @duya/client-core typecheck",
    "typecheck:runtime": "npm run build:packages -- --target @duya/agent-runtime && npm run -w @duya/agent-runtime typecheck",
    "typecheck:cli": "node scripts/build-packages.mjs --target @duya/cli && npm run -w @duya/cli typecheck",
    "typecheck:plugin-core": "npm run -w @duya/plugin-core typecheck",
    "typecheck:voice": "npm run -w @duya/voice typecheck",
    "typecheck:all": "npm run check:encoding && npm run check:manifest-keys && npm run check:test-coverage && npm run check:no-ts-suppress && npm run check:packaged-artifacts && npm run build:packages && npm run typecheck:protocol && npm run typecheck:client-core && npm run typecheck:core && npm run typecheck:runtime:prepared && npm run typecheck:web:prepared && npm run typecheck:electron:prepared && npm run typecheck:cli:prepared && npm run typecheck:web-app && npm run typecheck:voice && npm run typecheck:evals && npm run eval:agent:core:check",
    "architecture:check": "node scripts/architecture/architecture-check.mjs",
    "ci:test-scope": "node scripts/ci/test-scope.mjs",
    "perf:first-screen-budget": "node scripts/perf/first-screen-budget.mjs",
    "architecture:self-test": "node scripts/architecture/architecture-check.mjs --self-test",
    "architecture:slice-graph": "node scripts/architecture/import-graph.mjs && node scripts/architecture/compare-import-graphs.mjs",
    "architecture:baseline-ratchet": "node scripts/architecture/baseline-ratchet.mjs",
    "architecture:baseline": "node scripts/architecture/architecture-check.mjs --write",
    "architecture:boundaries": "node scripts/architecture/boundary-gates.mjs",
    "agent-retirement-gate": "node scripts/architecture/agent-retirement-gate.mjs",
    "architecture:headless": "node scripts/architecture/headless-load-gate.mjs",
    "architecture:browser-closure": "node scripts/architecture/browser-closure-gate.mjs",
    "architecture:client-closure": "node scripts/architecture/client-closure-gate.mjs",
    "architecture:ipc-census": "node scripts/architecture/ipc-channel-census.mjs",
    "pretest": "npm run build:packages && npm run bundle:worker && node scripts/ensure-sqlite-abi.mjs node",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:manifest-keys": "node scripts/check-manifest-keys.mjs",
    "check:no-ts-suppress": "node scripts/check-no-ts-suppress.mjs",
    "check:test-coverage": "node scripts/check-test-coverage.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:design-tokens-compiled": "node scripts/verify-design-tokens-compiled.mjs",
    "check:db-health": "node scripts/check-db-health.js",
    "sessions:rebuild-from-rollouts": "node scripts/import-legacy-rollouts.mjs",
    "sessions:verify-import": "node scripts/verify-import.mjs",
    "typecheck:evals": "node scripts/typecheck-electron-gate.mjs --project evals/tsconfig.json",
    "eval:agent:smoke": "node scripts/eval-agent.mjs smoke",
    "eval:agent:extended": "node scripts/eval-agent.mjs extended",
    "eval:agent:core": "npm run build:packages && node evals/agent/performance/run-core.mjs && node evals/agent/performance/run-io.mjs",
    "eval:agent:core:io": "node evals/agent/performance/run-io.mjs",
    "eval:agent:core:compare": "node evals/agent/performance/compare.mjs",
    "eval:agent:core:check": "node --test evals/agent/performance/recorder.test.mjs",
    "eval:agent:tui": "vitest run evals/agent/performance/tui.test.ts",
    "eval:agent:tui:compare": "node evals/agent/performance/compare-tui.mjs",
    "eval:agent:runtime": "vitest run evals/agent/performance/runtime-e2e.test.ts",
    "eval:agent:all": "npm run eval:agent:core && npm run eval:agent:tui && npm run eval:agent:runtime",
    "pretest:watch": "npm run build:packages && npm run bundle:worker && node scripts/ensure-sqlite-abi.mjs node",
    "pretest:coverage": "npm run build:packages && npm run bundle:worker && node scripts/ensure-sqlite-abi.mjs node",
    "pretest:e2e": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:smoke": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:ipc": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:turn": "node scripts/ensure-sqlite-abi.mjs electron",
    "pretest:e2e:ui-states": "node scripts/ensure-sqlite-abi.mjs electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "node tests/rules-compliance.test.mjs",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:inventory:write": "node scripts/test-inventory.mjs --write",
    "test:fault-injection": "node scripts/test-fault-injection.mjs --spec scripts/fault-injection.spec.json",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:smoke": "npx playwright test --config=e2e/playwright.config.ts --project=smoke",
    "test:e2e:ipc": "npx playwright test --config=e2e/playwright.config.ts --project=ipc",
    "test:e2e:turn": "npx playwright test --config=e2e/playwright.config.ts --project=turn",
    "test:e2e:ui-states": "npx playwright test --config=e2e/playwright.config.ts --project=ui-states",
    "build:electron": "node scripts/build-electron.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "showcase": "node scripts/showcase/showcase.mjs",
    "showcase:gif": "node scripts/showcase/showcase.mjs --gif",
    "showcase:compose-gif": "node scripts/showcase/compose-gif.mjs",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild",
    "rebuild:node": "node scripts/ensure-sqlite-abi.mjs node",
    "build:cli-dev": "node scripts/build-packages.mjs --target @duya/cli && npm run bundle:worker && npm run build:cli-bundle",
    "build:tui": "npm run build:cli-dev",
    "dev:tui": "node packages/cli/bundle/cli.cjs tui",
    "typecheck:runtime:prepared": "npm run -w @duya/agent-runtime typecheck",
    "typecheck:web:prepared": "tsc --noEmit",
    "typecheck:electron:prepared": "node scripts/typecheck-electron-gate.mjs",
    "typecheck:cli:prepared": "npm run -w @duya/cli typecheck"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "gifenc": "^1.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.9",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.2",
    "typescript": "^5.3.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iarna/toml": "^2.2.5",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@lobehub/icons": "^5.4.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@pierre/diffs": "^1.5.1",
    "@tabler/icons-react": "^3.43.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/handlebars": "^4.0.40",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.3.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "croner": "^9.1.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.38.0",
    "handlebars": "^4.7.9",
    "https-proxy-agent": "^9.0.0",
    "imapflow": "^1.7.8",
    "lucide-react": "^1.47.0",
    "mailparser": "^3.12.4",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "rbush": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "readable-stream": "^4.7.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "simple-icons": "^16.28.0",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-merge": "^3.5.0",
    "undici": "^6.29.1",
    "write-file-atomic": "^7.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "node-abi": "^4.35.0"
  }
}
